# ===================================================
# TAMTASK PRODUCTION ENVIRONMENT CONFIGURATION
# ===================================================

# Node Environment
NODE_ENV=production
PORT=3000
HOSTNAME="0.0.0.0"

# Application URL & Secret (IMPORTANT: Generate random 32-byte secret using: openssl rand -base64 32)
NEXTAUTH_URL=https://tamtask.yourdomain.com
NEXTAUTH_SECRET=replace_with_openssl_rand_base64_32_secure_secret_token

# Database Connection
# Option A (Cloud PostgreSQL - Recommended for Production):
# DATABASE_URL="postgresql://postgres:yourpassword@db.supabase.co:5432/postgres?sslmode=require"
# Option B (Local SQLite Persistent Volume):
DATABASE_URL="file:./dev.db"

# Google OAuth 2.0 Credentials (Create at console.cloud.google.com)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret

# Email Service (Resend Free Tier for 2FA OTP codes)
RESEND_API_KEY=re_your_resend_api_key

# Optional Mouse-1 Micro-decision API key
MOUSE1_API_KEY=

