# App Environment Variables
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-super-secret-nextauth-key-change-me

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Mouse-1 AI Decision Engine (https://mouse.dev)
# Ultra-fast System 1 decision layer for smart triage, auto-assignee & transition gating
MOUSE1_API_KEY=your-mouse1-api-key
MOUSE1_BASE_URL=https://api.mouse.dev/v1

# Database (PostgreSQL / SQLite for local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jira_clone?schema=public"

# Redis (For Automation Queue)
REDIS_URL="redis://localhost:6379"

